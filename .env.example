# Optional. Without a key the art director runs on rules alone, which is a
# complete design — the model pass only refines it.
#
# Any OpenAI-compatible chat-completions endpoint works.
#   deepseek -> https://api.deepseek.com/v1, deepseek-chat
#   kimi     -> https://api.moonshot.ai/v1, kimi-k2-0905-preview

DIRECTOR_PROVIDER=deepseek
DIRECTOR_API_KEY=
# DIRECTOR_MODEL=
# DIRECTOR_BASE_URL=

# Overrides for the service. The systemd unit sets these already.
# PORT=3058
# MAX_AUDIO_BYTES=41943040
# MAX_DURATION_SECONDS=720
# RETENTION_MS=21600000
