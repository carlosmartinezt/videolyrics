# ---------------------------------------------------------------------------
# Accounts and credits (Supabase).
#
# Without these the app still works end to end — align, design, preview — but
# there is no sign-in, no credit counter and no download gate. Create a NEW
# Supabase project (not the journal one), run supabase/migrations/0001, then
# paste the three values below. Settings -> API in the dashboard.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses every row-level policy. It belongs in
# this file and nowhere else: never in the browser, never in git.
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 once Google is configured as a provider in Supabase Auth, which
# shows the "Continue with Google" button. Magic link works either way.
AUTH_GOOGLE=0

# Free videos per person per month. Raising this only affects new periods;
# to change one person now, update their row in public.profiles.
FREE_CREDITS_PER_MONTH=5

# ---------------------------------------------------------------------------
# Watermark. Burned into every exported frame.
# ---------------------------------------------------------------------------

WATERMARK_TEXT=videolyrics.org
# WATERMARK_POSITION=bottom-right   # or bottom-left, top-right, top-left, bottom-centre
# WATERMARK_OPACITY=0.5
# WATERMARK_ENABLED=true

# ---------------------------------------------------------------------------
# Art director (optional). Any OpenAI-compatible chat-completions endpoint.
#   deepseek -> https://api.deepseek.com/v1, deepseek-chat
#   kimi     -> https://api.moonshot.ai/v1, kimi-k2-0905-preview
# Without a key the deterministic director runs alone, which is a complete
# design — the model pass only refines it.
# ---------------------------------------------------------------------------

DIRECTOR_PROVIDER=deepseek
DIRECTOR_API_KEY=
# DIRECTOR_MODEL=
# DIRECTOR_BASE_URL=

# ---------------------------------------------------------------------------
# Service overrides. The systemd unit already sets the important ones.
# ---------------------------------------------------------------------------

# PORT=3058
# MAX_AUDIO_BYTES=41943040
# MAX_DURATION_SECONDS=720
# RETENTION_MS=21600000
# MAX_JOBS_PER_IP=20          # signed in, per hour
# MAX_ANON_JOBS_PER_IP=3      # anonymous, per hour

# Development only. Replaces Supabase with an in-memory stub so the whole
# accounts flow can be exercised locally. Refuses to arm when NODE_ENV is
# production. Any email works; a token is literally "dev:<email>".
# AUTH_DEV_STUB=1
