# ---------------------------------------------------------------------------
# Email alerts to the owner (optional), sent through Resend: someone started
# a video, someone downloaded one, the art director ran out of credit. At most
# 60 a day. Without a key nothing is sent and the app works the same.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
# NOTIFY_TO=carlosmartinezt@gmail.com
# NOTIFY_FROM=videolyrics <info@saveyourchess.com>

# ---------------------------------------------------------------------------
# Watermark. Burned into every exported frame.
# ---------------------------------------------------------------------------

WATERMARK_TEXT=videolyrics.org
# WATERMARK_POSITION=bottom-right   # or bottom-left, top-right, top-left, bottom-centre
# WATERMARK_OPACITY=0.5
# WATERMARK_ENABLED=true

# ---------------------------------------------------------------------------
# Art director (optional). Any OpenAI-compatible chat-completions endpoint.
#   deepseek -> https://api.deepseek.com/v1, deepseek-chat
#   kimi     -> https://api.moonshot.ai/v1, kimi-k2-0905-preview
# Without a key the deterministic director runs alone, which is a complete
# design — the model pass only refines it.
# ---------------------------------------------------------------------------

DIRECTOR_PROVIDER=deepseek
DIRECTOR_API_KEY=
# DIRECTOR_MODEL=
# DIRECTOR_BASE_URL=

# ---------------------------------------------------------------------------
# Service overrides. The systemd unit already sets the important ones.
# ---------------------------------------------------------------------------

# Browser origins allowed to call this API, comma-separated. Leave unset while
# the page and the API share an origin, which is the case whenever Caddy serves
# dist/ itself. Needed only once the front end is hosted elsewhere:
#
#   ALLOWED_ORIGINS=https://videolyrics.org,https://videolyrics.vercel.app
#
# The same origins must appear in the page's connect-src, or the browser blocks
# the request before it is sent and the symptom is a network error with no
# message. See deploy/Caddyfile.snippet and vercel.json.
# ALLOWED_ORIGINS=

# PORT=3058
# MAX_AUDIO_BYTES=41943040
# MAX_DURATION_SECONDS=720
# RETENTION_MS=21600000
# MAX_JOBS_PER_IP=5           # songs per IP per hour
