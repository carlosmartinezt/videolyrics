# Caddy configuration for videolyrics.
#
# Install with:  sudo ops/install-caddy-site.sh
#
# That script replaces the managed region in /etc/caddy/Caddyfile, validates
# the result before touching the live file, and keeps a timestamped backup.
#
# videolyrics.org is a splash page on Vercel and nothing of it runs on this
# box. The alignment API that api.videolyrics.org served is switched off; its
# source is the `full-app` tag. Only the original address is left here, as a
# redirect.

# >>> videolyrics (managed by ops/install-caddy-site.sh) >>>

# The original address. Kept alive as a redirect rather than deleted, because
# it is in a git history and at least one screenshot.
videolyrics.carlosmartinezt.com {
    redir https://videolyrics.org{uri} permanent
}

# <<< videolyrics <<<
