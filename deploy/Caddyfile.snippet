# Caddy configuration for videolyrics.
#
# Install with:  sudo ops/install-caddy-site.sh
#
# That script replaces the managed region in /etc/caddy/Caddyfile, validates
# the result *before* touching the live file, and keeps a timestamped backup.
# Editing by hand is possible but this file serves six sites, and a stray
# brace takes all of them down at once.
#
# videolyrics.org is canonical because that is what is burned into every
# exported frame. www and the old subdomain redirect to it, so there is one
# origin — which also means one place for a browser session to live and one
# entry in Supabase's redirect allow-list.

# >>> videolyrics (managed by ops/install-caddy-site.sh) >>>

videolyrics.org {
    encode gzip zstd

    handle /api/* {
        reverse_proxy 127.0.0.1:3058 {
            # Alignment takes minutes on this box and progress arrives over
            # SSE. Both need Caddy to stop buffering and stop timing out.
            flush_interval -1
            transport http {
                read_timeout 30m
                write_timeout 30m
            }
        }
    }

    handle {
        root * /home/carlos/videolyrics/dist

        # Fonts are self-hosted. The page reaches exactly three places: here
        # for /api, Supabase for sign-in, and Google Analytics. blob: is
        # required because the finished MP4 is handed to the page as a blob
        # URL, and worker-src blob: because the media toolkit spawns workers.
        #
        # Note there is no 'unsafe-inline' in script-src: the GA snippet's
        # configuration lives in the bundle rather than an inline block, so
        # this page keeps a policy that would actually stop an injection.
        #
        # If you move off *.supabase.co, this connect-src is the thing that
        # will silently break sign-in — the symptom is a network error with no
        # message, because a CSP block is invisible to fetch().
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://www.googletagmanager.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; media-src 'self' blob:; connect-src 'self' blob: https://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
            Referrer-Policy "strict-origin-when-cross-origin"
            X-Content-Type-Options "nosniff"
            Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
            -Server
        }

        # Hashed assets are immutable; the shell must never be cached or a
        # deploy would leave people on the previous build.
        @assets path /assets/* /fonts/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache"

        try_files {path} /index.html
        file_server
    }
}

www.videolyrics.org {
    redir https://videolyrics.org{uri} permanent
}

# The original address. Kept alive as a redirect rather than deleted, because
# it is in a git history, a systemd unit comment and at least one screenshot.
videolyrics.carlosmartinezt.com {
    redir https://videolyrics.org{uri} permanent
}

# <<< videolyrics <<<
