# Caddy site block for videolyrics.carlosmartinezt.com
#
# Append to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
#
# Same pattern as journal and njtransit: Caddy serves the built SPA straight
# out of the repo's dist/, so `npm run build` *is* the deploy. /api proxies to
# the Node service (videolyrics-api.service), which owns the uploaded audio
# and runs the aligner.

videolyrics.carlosmartinezt.com {
    encode gzip zstd

    handle /api/* {
        reverse_proxy 127.0.0.1:3058 {
            # Alignment takes minutes on this box and progress arrives over
            # SSE. Both need Caddy to stop buffering and stop timing out.
            flush_interval -1
            transport http {
                read_timeout 30m
                write_timeout 30m
            }
        }
    }

    handle {
        root * /home/carlos/videolyrics/dist

        # Fonts are self-hosted and the app talks to exactly two origins: this
        # one, for /api, and Supabase, for sign-in. blob: is required because
        # the finished MP4 is handed to the page as a blob URL, and worker-src
        # blob: because the media toolkit spawns workers to encode.
        #
        # If you move off *.supabase.co, this connect-src is the thing that
        # will silently break sign-in — the symptom is a network error with no
        # message, because a CSP block is invisible to fetch().
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: https://*.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
            Referrer-Policy "strict-origin-when-cross-origin"
            X-Content-Type-Options "nosniff"
            Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
            -Server
        }

        # Hashed assets are immutable; the shell must never be cached or a
        # deploy would leave people on the previous build.
        @assets path /assets/* /fonts/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache"

        try_files {path} /index.html
        file_server
    }
}
