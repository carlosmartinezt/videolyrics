# videolyrics — the API that listens to songs.
#
# A *user* unit, which needs no sudo and still survives reboot because
# lingering is enabled for carlos (`loginctl enable-linger carlos`):
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/videolyrics-api.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now videolyrics-api
#
# ops/deploy.sh does all of that for you and is the normal way in.
#
# Logs:  journalctl --user -u videolyrics-api -f
#
# Credentials live in /home/carlos/videolyrics/.env — keep it chmod 600.
# That file carries the Supabase keys (accounts and credits) and, optionally,
# the art-director model key. Without Supabase, the app still aligns, designs
# and previews; only the download gate and the credit counter go away.

[Unit]
Description=videolyrics API (alignment + art direction, behind Caddy)
After=network-online.target

[Service]
Type=simple

# The deployed copy, never the repo. ops/deploy.sh publishes server/, shared/
# and the aligner's Python into here with a staged swap, so the source tree can
# be cleaned or re-cloned without touching what is running.
#
# systemd takes this literally and cannot read PUBLIC_ROOT, so the path is
# spelled out and every release calls assert_unit_workdir before swapping. If
# you move PUBLIC_ROOT, this line has to move with it by hand.
WorkingDirectory=/home/carlos/public/videolyrics-api
ExecStart=/usr/bin/env node server/index.mjs
Restart=always
RestartSec=3

# Only ever binds loopback; Caddy is the only thing that reaches it.
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3058

# The static ffmpeg build lives in ~/bin and is not on a service's PATH.
Environment=FFMPEG_BIN=/home/carlos/bin/ffmpeg
Environment=FFPROBE_BIN=/home/carlos/bin/ffprobe

# Three absolute paths back into the source tree, because a release replaces
# the working directory wholesale and none of these should go with it:
#
#   .venv    1.2 GB of torch. Rebuildable, but not per deploy, and copying it
#            each release would need 2.4 GB free for the .old alongside it.
#   .torch   1.6 GB of acoustic models. A cache, but losing it costs a 400 MB
#            download in the middle of somebody's first job.
#   data     the jobs themselves. State. Publishing over it would delete work
#            in flight.
#
# server/aligner.mjs and server/jobs.mjs default all three to paths relative to
# the code, which is right for `npm run dev` and wrong here, so they are set.
Environment=ALIGNER_PYTHON=/home/carlos/videolyrics/aligner/.venv/bin/python
Environment=TORCH_HOME=/home/carlos/videolyrics/aligner/.torch
Environment=DATA_DIR=/home/carlos/videolyrics/data/jobs

# Two cores, shared with five other services. One alignment at a time, and
# torch reads this at import — setting it later leaves it single-threaded.
Environment=ALIGNER_THREADS=2
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2

# The mark burned into every frame. Server-side on purpose: no client
# preference and no model output can switch it off.
Environment=WATERMARK_TEXT=videolyrics.org

EnvironmentFile=-/home/carlos/videolyrics/.env

NoNewPrivileges=true
PrivateTmp=true

# Alignment is memory-hungry in bursts; this box has 7.6 GB shared with
# everything else, so cap it rather than let a pathological upload swap.
MemoryMax=3G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=videolyrics-api

[Install]
WantedBy=default.target
